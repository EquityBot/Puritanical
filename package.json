{
  "name": "@ryanduguid/puritanical",
  "version": "1.0.0",
  "description": "Strict simplicity for coding agents: the smallest correct change, verified.",
  "keywords": ["opencode-plugin", "opencode", "puritanical", "pi-package", "pi", "skills", "qoder"],
  "license": "FSL-1.1-ALv2 AND MIT",
  "author": {
    "name": "EquityBot",
    "url": "https://github.com/EquityBot"
  },
  "homepage": "https://github.com/EquityBot/Puritanical",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EquityBot/Puritanical.git"
  },
  "bugs": {
    "url": "https://github.com/EquityBot/Puritanical/issues"
  },
  "main": "./.opencode/plugins/puritanical.mjs",
  "exports": {
    ".": "./.opencode/plugins/puritanical.mjs",
    "./plugin": "./.opencode/plugins/puritanical.mjs"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "!pi-extension/test/",
    "scripts/uninstall.js",
    "scripts/cursor-hooks.js",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "publishConfig": {
    "access": "public"
  }
}

